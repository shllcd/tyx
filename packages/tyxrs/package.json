{
  "name": "tyxrs",
  "version": "0.1.0",
  "description": "TypeScript runtime for the tyx wire format: encode and decode values from a tyx IR schema",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shllcd/tyx",
    "directory": "packages/tyxrs"
  },
  "keywords": [
    "serialization",
    "codec",
    "encoding",
    "schema",
    "tyx"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
